<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse.amazonservices</groupId>
        <artifactId>quarkus-amazon-services-build-parent</artifactId>
        <version>999-SNAPSHOT</version>
        <relativePath>../build-parent/pom.xml</relativePath>
    </parent>

    <artifactId>quarkus-amazon-services-services-parent</artifactId>
    <name>Quarkus - Amazon Services</name>
    <packaging>pom</packaging>

    <modules>
        <module>accessanalyzer</module>
        <module>account</module>
        <module>acm</module>
        <module>apigateway</module>
        <module>apigatewayv2</module>
        <module>apigatewaymanagementapi</module>
        <module>appconfig</module>
        <module>appconfigdata</module>
        <module>bedrock</module>
        <module>bedrockruntime</module>
        <module>costexplorer</module>
        <module>cloudwatch</module>
        <module>cloudwatchlogs</module>
        <module>dynamodb</module>
        <module>ecr</module>
        <module>ecs</module>
        <module>elasticloadbalancing</module>
        <module>elasticloadbalancingv2</module>
        <module>eventbridge</module>
        <module>iam</module>
        <module>inspector</module>
        <module>inspector2</module>
        <module>iot</module>
        <module>kinesis</module>
        <module>kms</module>
        <module>lambda</module>
        <module>marketplaceentitlement</module>
        <module>marketplacemetering</module>
        <module>neptune</module>
        <module>paymentcryptography</module>
        <module>paymentcryptographydata</module>
        <module>rds</module>
        <module>rdsdata</module>
        <module>rekognition</module>
        <module>resourcegroupstaggingapi</module>
        <module>secretsmanager</module>
        <module>ses</module>
        <module>sesv2</module>
        <module>sfn</module>
        <module>sns</module>
        <module>sso</module>
        <module>ssooidc</module>
        <module>ssm</module>
        <module>sts</module>
        <module>textract</module>
        <module>transfer</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>io.quarkiverse.amazonservices</groupId>
                    <artifactId>quarkus-amazon-codegen-maven-plugin</artifactId>
                    <version>${project.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>generate</goal>
                                <goal>generate-tests</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <codeGenResources>${basedir}/../src/main/resources/codegen-resources/</codeGenResources>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar.plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>test-jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Run the code generator on service runtime/deployment modules (outside of m2e) -->
        <profile>
            <id>codegen</id>
            <activation>
                <property>
                    <name>!m2e.version</name>
                </property>
                <file>
                    <exists>${basedir}/../src/main/resources/codegen-resources</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.quarkiverse.amazonservices</groupId>
                        <artifactId>quarkus-amazon-codegen-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- m2e cannot resolve the in-reactor codegen plugin: only expose the sources it generated -->
        <profile>
            <id>m2e</id>
            <activation>
                <property>
                    <name>m2e.version</name>
                </property>
                <file>
                    <exists>${basedir}/../src/main/resources/codegen-resources</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>add-codegen-sources</id>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>${project.build.directory}/generated-sources/sdk</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-codegen-test-sources</id>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>${project.build.directory}/generated-test-sources/sdk-tests</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
